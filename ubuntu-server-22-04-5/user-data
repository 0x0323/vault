#cloud-config
cloud_final_modules:
  - scripts_per_once
  - none

autoinstall:
  version: 1
  identity:
    realname: 'Vault User'
    username: vault
    password: '$6$wdAcoXrU039hKYPd$508Qvbe7ObUnxoj15DRCkzC3qO7edjH0VV7BPNRDYK4QR8ofJaEEF2heacn0QgD.f8pO8SNp83XNdWG6tocBM1'
    hostname: vault-ubuntu-minimal
  locale: "en_US.UTF-8"
  keyboard:
    layout: us
    variant: ""
  storage:
    layout:
      name: lvm
      sizing-policy: scaled
      password: vault-luks-passphrase
  ssh:
    install-server: true
    authorized-keys: []
    allow-pw: true
  updates: security
  shutdown: reboot
  package_update: true
  package_upgrade: true
  packages:
    - ufw
    - rsync
    - logrotate
    - cron

write_files:
  - content: |
      #!/bin/bash
      echo "Script executed" > /tmp/script_execution.log
      sudo touch /run/testfile.txt
    path: /var/lib/cloud/scripts/per-once/testscript.sh
    permissions: "0755"

runcmd:
  - echo "Running runcmd" >> /tmp/runcmd.log
  - sudo touch /etc/aaa_testfile
